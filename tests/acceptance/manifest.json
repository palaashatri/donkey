{
  "schema": "donkey.acceptance.v1",
  "note": "DESIGN §14 end-to-end acceptance projects. Every test named here must exist (acceptance.manifest checks it); its CI result on each platform is the pass/fail evidence. 'partial' states what is not covered; 'n/a' platforms are listed with the reason.",
  "projects": [
    {"id": "A01", "scenario": "ELF x86-64 hello, O0", "status": "pass",
     "fixtures": ["tests/fixtures/binaries/tiny-elf-x86_64", "tests/fixtures/debuggee/debuggee.c (built -O0)", "tests/corpus/corpus.c (built -O0)"],
     "tests": ["Binary.LoadsElfMetadata", "Analysis.ElfFindsCallTargetsFunctionsAndStrings", "CallGraph.MainCallsTickDirectlyAndIndirectCallsStayUnresolved", "Ir.LiftsElfEntryPointIntoVerifiedIr", "cli.info_elf_json", "DecompilerCorpus.CompleteResultsAgreeWithTheCompiledCode"]},
    {"id": "A02", "scenario": "ELF x86-64 arithmetic, O2", "status": "pass",
     "fixtures": ["tests/corpus/corpus.c (built -O2 and -O3 with the host compiler)"],
     "tests": ["DecompilerCorpus.CompleteResultsAgreeWithTheCompiledCode", "DecompilerCorpus.StructLayoutRecoveredBehindAPointerArgument"],
     "limits": "On Linux x86-64 hosts the corpus is ELF x86-64; other hosts check their own format and ISA."},
    {"id": "A03", "scenario": "PE x86-64 imports/exports", "status": "pass",
     "fixtures": ["tests/fixtures/binaries/tiny-pe-x86_64.exe", "tests/fixtures/binaries/tiny-pe-i386.exe"],
     "tests": ["Binary.LoadsPeImportsAndExports", "Binary.LoadsPe32ImportsAndExports", "Binary.PeCoffSymbolsAndLongSectionNamesAreRead", "Analysis.PeSeedsExportedFunction", "cli.info_pe_human"]},
    {"id": "A04", "scenario": "Mach-O arm64 thin binary", "status": "pass",
     "fixtures": ["tests/fixtures/binaries/tiny-macho-arm64"],
     "tests": ["Binary.LoadsMachOMetadata", "Decode.AArch64KnownPrologueAndReturn", "Ir.LiftsMachOArm64EntryPoint", "cli.info_macho_json", "cli.decompile_macho_aarch64"]},
    {"id": "A05", "scenario": "Mach-O universal binary", "status": "pass",
     "fixtures": ["tests/fixtures/binaries/tiny-macho-fat"],
     "tests": ["Binary.LoadsFatMachOSlicesAndRejectsMissingSlice", "cli.info_macho_fat_x86_json"]},
    {"id": "A06", "scenario": "Raw firmware blob", "status": "pass",
     "fixtures": ["synthetic bytes in the tests"],
     "tests": ["Binary.RawImportWithExplicitMetadata", "Binary.RawFallbackAndDeterministicHash", "cli.disasm_raw_x86_64_json"]},
    {"id": "A07", "scenario": "Truncated ELF/PE/Mach-O", "status": "pass",
     "fixtures": ["every fixture in tests/fixtures/binaries, truncated at every length"],
     "tests": ["Binary.TruncatedFixturesNeverCrashOrHang", "Binary.CorruptedHeadersAreRejectedDeterministically", "Cfg.TruncatedInputsNeverHangOrCrash", "Ir.TruncatedElfNeverProducesInvalidIr", "DebugInfo.MalformedSectionsAreBoundedAndDeterministic"]},
    {"id": "A08", "scenario": "Maliciously large declared section", "status": "pass",
     "fixtures": ["mutated headers in the tests"],
     "tests": ["Binary.EnforcesFileSizeLimit", "LargeFile.OversizedFilesAreRejectedBeforeAnyAllocation", "Binary.SectionsWithoutAddressNeverClaimVirtualSpace", "AcceptanceSuite.A24_BoundedMemoryOnLargeOrMalformedFile"]},
    {"id": "A09", "scenario": "x86-64 branch-heavy CFG", "status": "pass",
     "fixtures": ["synthetic code in the tests", "tests/corpus/corpus.c"],
     "tests": ["Cfg.BuildsBlocksAndConditionalEdges", "Ir.LiftsSyntheticBranchyX86Function", "DecompilerCorpus.JumpTableIsRecoveredWithEvidence", "CallGraph.MainCallsTickDirectlyAndIndirectCallsStayUnresolved"]},
    {"id": "A10", "scenario": "Large function index", "status": "pass", "ui": true,
     "fixtures": ["1,000,000-row synthetic table", "10,005-block synthetic function"],
     "tests": ["ui.script_virtualization", "GraphLayout.TenThousandNodeFunctionLaysOutQuickly"]},
    {"id": "A11", "scenario": "Symbol rename + type correction", "status": "partial",
     "fixtures": ["tests/fixtures/debuggee/debuggee.c (built -g)"],
     "tests": ["Session.UndoAndRedoEdits", "Session.FunctionBoundaryEditsReanalyseUndoAndPersist", "Session.DebugInfoNamesNeverReplaceUserRenames", "cli.project_rename"],
     "limits": "Renames and function-boundary edits persist and re-run analysis; user-entered type corrections are not implemented (types come from DWARF only)."},
    {"id": "A12", "scenario": "Database migration from older schema", "status": "pass",
     "fixtures": ["schema v1, v2 and v3 databases built by the tests"],
     "tests": ["Project.MigratesVersionOneDatabaseForward", "Project.MigratesVersionTwoDatabaseToVersionThree", "Project.MigratesSchemaV3AnnotationsToV4AndAcceptsFunctionEdits", "Project.RejectsNewerSchemaWithoutTouchingIt", "Project.BacksUpAndRestoresAnnotations"]},
    {"id": "A13", "scenario": "Transaction cancellation", "status": "pass",
     "fixtures": ["project databases built by the tests"],
     "tests": ["Project.FailedImportRollsBackEverything", "Project.RestoreHonorsCancellationBeforeReplacingDatabase", "Session.CancellationStopsRunningTask", "Session.SupersededRestoreAtCommitBoundaryDoesNotMutateDatabase", "Stages/InterruptedReplace.LeavesEitherCompleteOldOrCompleteNewDatabase/1-byte object <00>"]},
    {"id": "A14", "scenario": "Two independent binaries linked by imports", "status": "partial",
     "fixtures": ["tests/fixtures/binaries/tiny-elf-x86_64", "tests/fixtures/binaries/tiny-pe-x86_64.exe"],
     "tests": ["AcceptanceSuite.A14_TwoIndependentBinariesHaveDistinctIdentitiesAndImports"],
     "limits": "Distinct identities and import namespaces are checked; resolving an import to its definition in the other image is not implemented."},
    {"id": "A15", "scenario": "IR arithmetic/flags corpus", "status": "pass",
     "fixtures": ["tests/corpus/corpus.c"],
     "tests": ["Ir.SemanticOracleBitVectorArithmetic", "Ir.SemanticOracleFlagsAndConditions", "Ir.PreservesUnsupportedInstructionsAsOpaqueEffects", "DecompilerCorpus.CompleteResultsAgreeWithTheCompiledCode"]},
    {"id": "A16", "scenario": "If/loop decompiler corpus", "status": "pass",
     "fixtures": ["tests/corpus/corpus.c"],
     "tests": ["Ir.AcceptanceScenarioA16_SourceMapNavigation", "Ir.StructuresIfThenElse", "Ir.StructuresWhileLoop", "Ir.StructuresDoWhileLoop", "DecompilerCorpus.CompleteResultsAgreeWithTheCompiledCode"]},
    {"id": "A17", "scenario": "Switch/jump-table corpus", "status": "pass",
     "fixtures": ["tests/corpus/corpus.c (c_switch_dense, c_switch_sparse)"],
     "tests": ["DecompilerCorpus.JumpTableIsRecoveredWithEvidence", "Ir.AcceptanceScenarioA17_GracefulUnresolvedJumpTable", "Ir.StructuresReducibleSwitchStatement"],
     "limits": "Jump tables are recovered on x86 and x86-64; AArch64 tables stay unresolved indirect branches (reported, not guessed)."},
    {"id": "A18", "scenario": "Local debugger launch fixture", "status": "pass",
     "fixtures": ["tests/fixtures/debuggee/debuggee.c"],
     "tests": ["NativeDebug.LaunchStopsAtTheRealProgramEntry", "NativeDebug.BreakpointsHitAndMemoryWritesChangeTheTarget", "NativeDebug.SingleStepAndStepOutMoveTheRealProgramCounter", "NativeDebug.RunsToExitWithTheRealExitCode", "DebugController.RunsARealTargetWithoutBlockingTheCaller"],
     "platforms": "Linux x86-64, Linux AArch64, Windows x64",
     "na": "macOS, FreeBSD, Windows arm64: no native debugger (NativeDebug.UnsupportedHostsReportNothingAndFabricateNothing runs there)"},
    {"id": "A19", "scenario": "ASLR-enabled debugger fixture", "status": "pass",
     "fixtures": ["tests/fixtures/debuggee/debuggee.c", "tests/fixtures/debuggee/module.c"],
     "tests": ["NativeDebug.RelocatedExecutableTranslatesToItsStaticImage", "NativeDebug.ModuleLoadedAfterLaunchMapsToItsStaticImage"],
     "platforms": "Linux x86-64, Linux AArch64, Windows x64", "na": "as A18"},
    {"id": "A20", "scenario": "Plugin bad-version/crash fixture", "status": "pass",
     "fixtures": ["tests/fixtures/plugins/*.c"],
     "tests": ["PluginTest.RejectsBadAbiVersionExplicitly", "PluginTest.IsolatedCrashFixtureVerifiesA20", "PluginTest.IsolatedHangFixtureTimesOutCleanly", "PluginTest.TrustedPluginIsUnloadedAfterEachExecution"],
     "limits": "Process isolation is POSIX only; on Windows isolated execution fails closed (plugin.isolation_unavailable)."},
    {"id": "A21", "scenario": "Hex patch + export fixture", "status": "pass",
     "fixtures": ["tests/fixtures/binaries/tiny-elf-x86_64"],
     "tests": ["PatchTest.ExportPatchedBinaryVerifiesA21", "cli.patch_apply_json", "cli.patch_refuses_overwrite_without_force"]},
    {"id": "A22", "scenario": "Multimonitor workspace fixture", "status": "partial", "ui": true,
     "fixtures": ["tests/ui/display_dpi_device.donkeyui", "tests/ui/layout_save.donkeyui", "tests/ui/layout_restore.donkeyui"],
     "tests": ["ui.script_display_dpi_device", "ui.script_layout_save", "ui.script_layout_restore"],
     "limits": "Dock/save/reopen and recovery from a removed display are tested with synthesised SDL events on one virtual display; real monitor hot-plug and per-monitor DPI hardware were not exercised."},
    {"id": "A23", "scenario": "Unicode/IME/keyboard navigation", "status": "pass", "ui": true,
     "fixtures": ["tests/ui/keyboard_ime.donkeyui"],
     "tests": ["ui.script_keyboard_ime", "ui.script_gallery_keyboard", "AcceptanceSuite.A22_A23_UnicodeAnnotationsAndHistoryRoundtrip"],
     "limits": "IME composition and commit events are injected; the operating system's own candidate window is outside the test."},
    {"id": "A24", "scenario": "1 GiB or malformed oversized file", "status": "pass",
     "fixtures": ["debuggee extended to 100 MiB and 1 GiB at test time"],
     "tests": ["LargeFile.Mapped100MiBImageStaysWithinMemoryBudget", "AcceptanceSuite.A24_BoundedMemoryOnLargeOrMalformedFile"],
     "limits": "The 1 GiB case (large.load_and_analyse_1gib) runs in Release builds only; FreeBSD has no memory counter and skips the budget check."},
    {"id": "A25", "scenario": "Architecture capability matrix", "status": "pass",
     "fixtures": ["all binary fixtures"],
     "tests": ["AcceptanceSuite.A25_ArchitectureCapabilityTruthMatrix", "Ir.RefusesArchitecturesTheLifterDoesNotModel", "cli.decompile_elf_i386"]},
    {"id": "A26", "scenario": "Offline headless import/report", "status": "pass",
     "fixtures": ["tests/fixtures/binaries/tiny-elf-x86_64"],
     "tests": ["AcceptanceSuite.A26_OfflineHeadlessFullPipeline", "deps.core_has_no_ui_links", "cli.analyze_elf_json"]}
  ]
}
