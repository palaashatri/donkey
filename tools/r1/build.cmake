# R1, the reference corpus of real programs (G20-T1): fetch the pinned sources, check their SHA-256,
# unpack them, and build every binary of the manifest, unstripped and stripped. Run in script mode:
#
#   cmake -DR1_WORK=<dir> [-DR1_MANIFEST=<r1.json>] [-DR1_STEP=fetch|build|all] -P tools/r1/build.cmake
#
# R1_WORK holds `downloads/` (the archives, kept between runs), `src/`, `out/` and `binaries.json`.
# Nothing it writes belongs in the repository. A source is used only after its archive matches the
# manifest's SHA-256; an archive member with an absolute path or a `..` component is refused before
# anything is unpacked. See tools/r1/README.md and docs/IDA_GAP_LEDGER.md (G20-T0).

cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED R1_WORK)
  message(FATAL_ERROR "r1: R1_WORK (the work directory) is required")
endif()
# The compiler runs in each source tree, so every path built from R1_WORK must be absolute. In
# script mode CMAKE_CURRENT_BINARY_DIR is the directory cmake was run from.
cmake_path(ABSOLUTE_PATH R1_WORK BASE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}" NORMALIZE)
if(NOT DEFINED R1_MANIFEST)
  set(R1_MANIFEST "${CMAKE_CURRENT_LIST_DIR}/r1.json")
endif()
if(NOT DEFINED R1_STEP)
  set(R1_STEP all)
endif()
if(NOT R1_STEP MATCHES "^(fetch|build|all)$")
  message(FATAL_ERROR "r1: R1_STEP must be fetch, build or all, not '${R1_STEP}'")
endif()
# The largest archive allowed; the pinned ones are under 3 MiB.
set(R1_MAX_ARCHIVE_BYTES 67108864)

file(READ "${R1_MANIFEST}" manifest)

# --- The manifest schema: every object may carry only its own keys, and every key it needs. ------

function(r1_json out)
  string(JSON value ERROR_VARIABLE error GET "${manifest}" ${ARGN})
  if(error)
    message(FATAL_ERROR "r1: manifest: ${error}")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(r1_length out)
  string(JSON value ERROR_VARIABLE error LENGTH "${manifest}" ${ARGN})
  if(error)
    message(FATAL_ERROR "r1: manifest: ${error}")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# r1_keys(<label> <allowed keys...> PATH <json path...>): refuse a key that is not allowed, and a
# required key (all the allowed ones here) that is missing.
function(r1_keys label)
  cmake_parse_arguments(PARSE_ARGV 1 arg "" "" "KEYS;PATH")
  string(JSON type ERROR_VARIABLE error TYPE "${manifest}" ${arg_PATH})
  if(error OR NOT type STREQUAL "OBJECT")
    message(FATAL_ERROR "r1: manifest: ${label} is not an object")
  endif()
  r1_length(count ${arg_PATH})
  set(present "")
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON key MEMBER "${manifest}" ${arg_PATH} ${i})
      if(NOT key IN_LIST arg_KEYS)
        message(FATAL_ERROR "r1: manifest: unknown key '${key}' in ${label}")
      endif()
      list(APPEND present "${key}")
    endforeach()
  endif()
  foreach(key IN LISTS arg_KEYS)
    if(NOT key IN_LIST present)
      message(FATAL_ERROR "r1: manifest: ${label} has no '${key}'")
    endif()
  endforeach()
endfunction()

# r1_strings(<out> <json path...>): a JSON array of strings, as a CMake list.
function(r1_strings out)
  r1_length(count ${ARGN})
  set(values "")
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON type TYPE "${manifest}" ${ARGN} ${i})
      if(NOT type STREQUAL "STRING")
        message(FATAL_ERROR "r1: manifest: an entry of ${ARGN} is not a string")
      endif()
      r1_json(value ${ARGN} ${i})
      list(APPEND values "${value}")
    endforeach()
  endif()
  set(${out} "${values}" PARENT_SCOPE)
endfunction()

r1_keys("the manifest" KEYS schema toolchains sources builds PATH)
r1_json(schema schema)
if(NOT schema EQUAL 1)
  message(FATAL_ERROR "r1: manifest: schema ${schema} is not 1")
endif()

r1_length(toolchain_count toolchains)
r1_length(source_count sources)
r1_length(build_count builds)
if(toolchain_count EQUAL 0 OR source_count EQUAL 0 OR build_count EQUAL 0)
  message(FATAL_ERROR "r1: manifest: toolchains, sources and builds must not be empty")
endif()
math(EXPR toolchain_last "${toolchain_count} - 1")
set(toolchains "")
foreach(i RANGE ${toolchain_last})
  string(JSON name MEMBER "${manifest}" toolchains ${i})
  r1_keys("toolchain ${name}" KEYS cc strip strip_package package PATH toolchains ${name})
  list(APPEND toolchains "${name}")
endforeach()

math(EXPR source_last "${source_count} - 1")
set(sources "")
foreach(i RANGE ${source_last})
  r1_keys("source ${i}" KEYS name version licence url sha256 root PATH sources ${i})
  r1_json(name sources ${i} name)
  # The name is a directory under src/ that is removed and unpacked into: one plain component.
  if(NOT name MATCHES "^[A-Za-z0-9._-]+$" OR name STREQUAL "." OR name STREQUAL "..")
    message(FATAL_ERROR "r1: manifest: unsafe source name '${name}'")
  endif()
  r1_json(sha sources ${i} sha256)
  string(LENGTH "${sha}" sha_length)
  if(NOT sha MATCHES "^[0-9a-f]+$" OR NOT sha_length EQUAL 64)
    message(FATAL_ERROR "r1: manifest: source ${name} has no valid sha256")
  endif()
  r1_json(root sources ${i} root)
  if(NOT root MATCHES "^[A-Za-z0-9._-]+$" OR root STREQUAL "." OR root STREQUAL "..")
    message(FATAL_ERROR "r1: manifest: source ${name} has an unsafe root '${root}'")
  endif()
  list(APPEND sources "${name}")
  set(source_index_${name} ${i})
endforeach()

math(EXPR build_last "${build_count} - 1")
foreach(i RANGE ${build_last})
  r1_keys("build ${i}" KEYS name source kind files flags libs levels toolchains PATH builds ${i})
  r1_json(name builds ${i} name)
  if(NOT name MATCHES "^[A-Za-z0-9._-]+$" OR name STREQUAL "." OR name STREQUAL "..")
    message(FATAL_ERROR "r1: manifest: unsafe build name '${name}'")
  endif()
  r1_json(source builds ${i} source)
  if(NOT source IN_LIST sources)
    message(FATAL_ERROR "r1: manifest: build ${name} names an unknown source '${source}'")
  endif()
  r1_json(kind builds ${i} kind)
  if(NOT kind MATCHES "^(shared|executable|static-executable)$")
    message(FATAL_ERROR "r1: manifest: build ${name} has an unknown kind '${kind}'")
  endif()
  r1_strings(levels builds ${i} levels)
  foreach(level IN LISTS levels)
    if(NOT level MATCHES "^O[0-3s]$")
      message(FATAL_ERROR "r1: manifest: build ${name} has an unknown level '${level}'")
    endif()
  endforeach()
  r1_strings(used builds ${i} toolchains)
  foreach(toolchain IN LISTS used)
    if(NOT toolchain IN_LIST toolchains)
      message(FATAL_ERROR "r1: manifest: build ${name} names an unknown toolchain '${toolchain}'")
    endif()
  endforeach()
  r1_strings(files builds ${i} files)
  foreach(file IN LISTS files)
    if(IS_ABSOLUTE "${file}" OR file MATCHES "(^|/)\\.\\.(/|$)")
      message(FATAL_ERROR "r1: manifest: build ${name} lists an unsafe file '${file}'")
    endif()
  endforeach()
endforeach()

file(MAKE_DIRECTORY "${R1_WORK}/downloads" "${R1_WORK}/src" "${R1_WORK}/out")

# --- Fetch and unpack. ---------------------------------------------------------------------------

function(r1_fetch index)
  r1_json(name sources ${index} name)
  r1_json(url sources ${index} url)
  r1_json(sha sources ${index} sha256)
  r1_json(root sources ${index} root)
  get_filename_component(archive_name "${url}" NAME)
  set(archive "${R1_WORK}/downloads/${archive_name}")
  # A cached archive is used only if it still has the pinned hash.
  if(EXISTS "${archive}")
    file(SHA256 "${archive}" have)
    if(NOT have STREQUAL sha)
      file(REMOVE "${archive}")
    endif()
  endif()
  if(NOT EXISTS "${archive}")
    set(attempt 1)
    while(TRUE)
      file(DOWNLOAD "${url}" "${archive}.part" STATUS status TLS_VERIFY ON)
      list(GET status 0 code)
      list(GET status 1 reason)
      if(code EQUAL 0)
        # The hash is checked here rather than with EXPECTED_HASH, so a file that does not match is
        # deleted and never retried: it is not the pinned one.
        file(SHA256 "${archive}.part" got)
        if(NOT got STREQUAL sha)
          file(REMOVE "${archive}.part")
          message(FATAL_ERROR "r1: ${name}: the SHA-256 of ${url} is ${got}, not the pinned ${sha}")
        endif()
        file(RENAME "${archive}.part" "${archive}")
        break()
      endif()
      file(REMOVE "${archive}.part")
      if(attempt GREATER_EQUAL 3)
        message(FATAL_ERROR "r1: fetch failed for ${name} (${url}) after ${attempt} attempts: ${reason}")
      endif()
      math(EXPR attempt "${attempt} + 1")
      execute_process(COMMAND ${CMAKE_COMMAND} -E sleep 5)
    endwhile()
  endif()
  file(SIZE "${archive}" bytes)
  if(bytes GREATER R1_MAX_ARCHIVE_BYTES)
    message(FATAL_ERROR "r1: ${archive_name} is larger than ${R1_MAX_ARCHIVE_BYTES} bytes")
  endif()
  # Check every member's path before anything is unpacked.
  execute_process(COMMAND ${CMAKE_COMMAND} -E tar tf "${archive}"
                  RESULT_VARIABLE listed OUTPUT_VARIABLE members ERROR_VARIABLE list_error)
  if(NOT listed EQUAL 0)
    message(FATAL_ERROR "r1: cannot list ${archive_name}: ${list_error}")
  endif()
  string(REPLACE "\n" ";" members "${members}")
  foreach(member IN LISTS members)
    if(member STREQUAL "")
      continue()
    endif()
    if(member MATCHES "^/" OR member MATCHES "^[A-Za-z]:" OR member MATCHES "\\\\"
       OR member MATCHES "(^|/)\\.\\.(/|$)")
      message(FATAL_ERROR "r1: ${archive_name} has an unsafe member '${member}'")
    endif()
    if(NOT member MATCHES "^${root}(/|$)")
      message(FATAL_ERROR "r1: ${archive_name} has a member outside ${root}/: '${member}'")
    endif()
  endforeach()
  # Only regular files and directories are unpacked. A symbolic or hard link could point outside
  # the source tree, and a later member written through it would land there; the member names
  # checked above say nothing about link targets. The pinned archives hold no links.
  execute_process(COMMAND ${CMAKE_COMMAND} -E tar tvf "${archive}"
                  RESULT_VARIABLE listed OUTPUT_VARIABLE entries ERROR_VARIABLE list_error)
  if(NOT listed EQUAL 0)
    message(FATAL_ERROR "r1: cannot list ${archive_name}: ${list_error}")
  endif()
  string(REPLACE "\n" ";" entries "${entries}")
  foreach(entry IN LISTS entries)
    if(entry STREQUAL "")
      continue()
    endif()
    if(NOT entry MATCHES "^[-d]" OR entry MATCHES " link to ")
      message(FATAL_ERROR "r1: ${archive_name} has a member that is not a file or a directory: '${entry}'")
    endif()
  endforeach()
  set(destination "${R1_WORK}/src/${name}")
  file(REMOVE_RECURSE "${destination}")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${destination}")
  if(NOT IS_DIRECTORY "${destination}/${root}")
    message(FATAL_ERROR "r1: ${archive_name} did not unpack into ${root}/")
  endif()
  message(STATUS "r1: ${name} ${sha} unpacked")
endfunction()

if(R1_STEP STREQUAL "fetch" OR R1_STEP STREQUAL "all")
  foreach(name IN LISTS sources)
    r1_fetch(${source_index_${name}})
  endforeach()
endif()

if(R1_STEP STREQUAL "fetch")
  return()
endif()

# --- Build. --------------------------------------------------------------------------------------

# The first line of a tool's --version, and a package's version where dpkg knows it.
function(r1_identity out tool package)
  execute_process(COMMAND ${tool} --version RESULT_VARIABLE result OUTPUT_VARIABLE text
                  ERROR_QUIET)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "r1: ${tool} is not usable")
  endif()
  string(REGEX MATCH "^[^\n]*" first "${text}")
  set(version "unknown")
  find_program(DPKG_QUERY dpkg-query)
  if(DPKG_QUERY)
    execute_process(COMMAND ${DPKG_QUERY} -W -f=\${Version} ${package}
                    RESULT_VARIABLE found OUTPUT_VARIABLE version_text ERROR_QUIET)
    if(found EQUAL 0 AND NOT version_text STREQUAL "")
      set(version "${version_text}")
    endif()
  endif()
  set(${out} "${first} (${package} ${version})" PARENT_SCOPE)
endfunction()

function(r1_quote out text)
  string(REPLACE "\\" "\\\\" text "${text}")
  string(REPLACE "\"" "\\\"" text "${text}")
  set(${out} "\"${text}\"" PARENT_SCOPE)
endfunction()

function(r1_quote_list out)
  set(items "")
  foreach(item IN LISTS ARGN)
    r1_quote(quoted "${item}")
    list(APPEND items "${quoted}")
  endforeach()
  list(JOIN items ", " joined)
  set(${out} "[${joined}]" PARENT_SCOPE)
endfunction()

set(entries "")
foreach(i RANGE ${build_last})
  r1_json(build builds ${i} name)
  r1_json(source builds ${i} source)
  r1_json(kind builds ${i} kind)
  r1_strings(files builds ${i} files)
  r1_strings(flags builds ${i} flags)
  r1_strings(libs builds ${i} libs)
  r1_strings(levels builds ${i} levels)
  r1_strings(used builds ${i} toolchains)
  set(s ${source_index_${source}})
  r1_json(root sources ${s} root)
  r1_json(version sources ${s} version)
  r1_json(licence sources ${s} licence)
  r1_json(source_sha sources ${s} sha256)
  set(tree "${R1_WORK}/src/${source}/${root}")
  if(NOT IS_DIRECTORY "${tree}")
    message(FATAL_ERROR "r1: ${tree} is missing; run the fetch step first")
  endif()
  set(paths "")
  foreach(file IN LISTS files)
    if(NOT EXISTS "${tree}/${file}")
      message(FATAL_ERROR "r1: ${source} has no ${file}")
    endif()
    list(APPEND paths "${tree}/${file}")
  endforeach()
  foreach(toolchain IN LISTS used)
    r1_json(cc toolchains ${toolchain} cc)
    r1_json(strip_tool toolchains ${toolchain} strip)
    r1_json(package toolchains ${toolchain} package)
    r1_identity(cc_identity ${cc} ${package})
    r1_json(strip_package toolchains ${toolchain} strip_package)
    r1_identity(strip_identity ${strip_tool} ${strip_package})
    string(REGEX MATCH "^[^-]+" arch "${toolchain}")
    foreach(level IN LISTS levels)
      set(binary "${build}-${toolchain}-${level}")
      set(mode_flags "")
      if(kind STREQUAL "shared")
        set(binary "${binary}.so")
        set(mode_flags -fPIC -shared)
      elseif(kind STREQUAL "static-executable")
        set(mode_flags -static)
      endif()
      # The prefix map takes the work directory out of the debug information and the strings, so
      # the same inputs give the same bytes wherever they are built.
      set(command ${cc} -${level} -g -ffile-prefix-map=${tree}=. ${mode_flags} ${flags}
                  -I${tree} -o ${R1_WORK}/out/${binary} ${paths} ${libs})
      execute_process(COMMAND ${command} WORKING_DIRECTORY "${tree}"
                      RESULT_VARIABLE built OUTPUT_VARIABLE build_output ERROR_VARIABLE build_output)
      if(NOT built EQUAL 0)
        message(FATAL_ERROR "r1: building ${binary} failed:\n${build_output}")
      endif()
      execute_process(COMMAND ${strip_tool} -o ${R1_WORK}/out/${binary}.stripped
                              ${R1_WORK}/out/${binary}
                      RESULT_VARIABLE stripped ERROR_VARIABLE strip_output)
      if(NOT stripped EQUAL 0)
        message(FATAL_ERROR "r1: stripping ${binary} failed:\n${strip_output}")
      endif()
      foreach(variant unstripped stripped)
        set(file_name "${binary}")
        if(variant STREQUAL "stripped")
          set(file_name "${binary}.stripped")
        endif()
        file(SHA256 "${R1_WORK}/out/${file_name}" binary_sha)
        r1_quote(q_file "${file_name}")
        r1_quote(q_build "${build}")
        r1_quote(q_source "${source} ${version}")
        r1_quote(q_licence "${licence}")
        r1_quote(q_source_sha "${source_sha}")
        r1_quote(q_toolchain "${toolchain}")
        r1_quote(q_arch "${arch}")
        r1_quote(q_level "${level}")
        r1_quote(q_variant "${variant}")
        r1_quote(q_cc "${cc_identity}")
        r1_quote(q_strip "${strip_identity}")
        r1_quote(q_sha "${binary_sha}")
        # The flags as the compiler was given them, with the source tree written as <src>: its
        # absolute path depends on R1_WORK, and the prefix map removes it from the binary.
        r1_quote_list(q_flags -${level} -g -ffile-prefix-map=<src>=. ${mode_flags} ${flags}
                      -I<src> ${libs})
        set(twin "null")
        if(variant STREQUAL "stripped")
          r1_quote(twin "${binary}")
        endif()
        list(APPEND entries
             "    {\"file\": ${q_file}, \"build\": ${q_build}, \"source\": ${q_source}, \"licence\": ${q_licence}, \"source_sha256\": ${q_source_sha}, \"toolchain\": ${q_toolchain}, \"architecture\": ${q_arch}, \"level\": ${q_level}, \"variant\": ${q_variant}, \"unstripped\": ${twin}, \"compiler\": ${q_cc}, \"strip\": ${q_strip}, \"flags\": ${q_flags}, \"sha256\": ${q_sha}}")
      endforeach()
      message(STATUS "r1: built ${binary}")
    endforeach()
  endforeach()
endforeach()

list(JOIN entries ",\n" body)
file(WRITE "${R1_WORK}/binaries.json" "{\n  \"schema\": 1,\n  \"binaries\": [\n${body}\n  ]\n}\n")
list(LENGTH entries binary_count)
message(STATUS "r1: ${binary_count} binaries, listed in ${R1_WORK}/binaries.json")
