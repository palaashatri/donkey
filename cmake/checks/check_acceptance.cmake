cmake_minimum_required(VERSION 3.25)
# cmake -DMANIFEST=<json> -DBUILD_DIR=<dir> -DCTEST=<ctest> -DUI=<ON|OFF>
#       -DSOURCE_DIR=<repo> -P check_acceptance.cmake
# Every acceptance project names tests that are registered in this build
# (UI projects only when the UI tests are built) and fixture files that
# exist. A missing test fails: the manifest cannot claim what is not run.
file(READ "${MANIFEST}" text)
execute_process(COMMAND "${CTEST}" -N WORKING_DIRECTORY "${BUILD_DIR}"
                OUTPUT_VARIABLE listing RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "ctest -N failed")
endif()
string(JSON count LENGTH "${text}" projects)
math(EXPR last "${count} - 1")
set(passing 0)
set(failed FALSE)
foreach(i RANGE ${last})
  string(JSON id GET "${text}" projects ${i} id)
  string(JSON status GET "${text}" projects ${i} status)
  string(JSON ui ERROR_VARIABLE no_ui GET "${text}" projects ${i} ui)
  if(status STREQUAL "pass")
    math(EXPR passing "${passing} + 1")
  endif()
  if(ui STREQUAL "ON" AND NOT UI)
    continue()
  endif()
  string(JSON tests LENGTH "${text}" projects ${i} tests)
  math(EXPR tlast "${tests} - 1")
  foreach(t RANGE ${tlast})
    string(JSON name GET "${text}" projects ${i} tests ${t})
    string(FIND "${listing}" ": ${name}\n" found)
    if(found EQUAL -1)
      message(SEND_ERROR "${id}: test '${name}' is not registered")
      set(failed TRUE)
    endif()
  endforeach()
  string(JSON fixtures LENGTH "${text}" projects ${i} fixtures)
  math(EXPR flast "${fixtures} - 1")
  foreach(f RANGE ${flast})
    string(JSON fixture GET "${text}" projects ${i} fixtures ${f})
    string(REGEX REPLACE " .*$" "" path "${fixture}")
    if(path MATCHES "^tests/" AND NOT path MATCHES "\\*" AND NOT EXISTS "${SOURCE_DIR}/${path}")
      message(SEND_ERROR "${id}: fixture '${path}' does not exist")
      set(failed TRUE)
    endif()
  endforeach()
endforeach()
if(failed)
  message(FATAL_ERROR "acceptance manifest refers to missing tests or fixtures")
endif()
if(passing LESS 20)
  message(FATAL_ERROR "only ${passing} acceptance projects are marked pass (M12 needs 20)")
endif()
message(STATUS "${count} acceptance projects, ${passing} marked pass; every referenced test is registered")
