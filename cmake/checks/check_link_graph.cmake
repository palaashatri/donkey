# cmake -DGRAPH=<file> -P check_link_graph.cmake
# Fails when a headless core target links SDL, Dear ImGui or the UI library.
file(STRINGS "${GRAPH}" lines)
if(NOT lines)
  message(FATAL_ERROR "empty link graph: ${GRAPH}")
endif()
set(failed FALSE)
foreach(line IN LISTS lines)
  string(REGEX MATCH "^([^:]+):(.*)$" _ "${line}")
  set(target "${CMAKE_MATCH_1}")
  string(REPLACE " " ";" links "${CMAKE_MATCH_2}")
  foreach(link IN LISTS links)
    string(TOLOWER "${link}" lowered)
    if(lowered MATCHES "sdl|imgui|^donkey_ui$|^donkey::ui$|vulkan|opengl|^gl$|d3d|metal")
      message(SEVERE_ERROR "forbidden dependency: ${target} -> ${link}")
      set(failed TRUE)
    endif()
  endforeach()
endforeach()
if(failed)
  message(FATAL_ERROR "headless core reaches UI/graphics libraries")
endif()
list(LENGTH lines count)
message(STATUS "${count} core targets checked; none reaches SDL, ImGui or the UI")
