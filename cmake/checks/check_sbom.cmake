cmake_minimum_required(VERSION 3.25)
# cmake -DSBOM=<file> -P check_sbom.cmake: the SBOM parses as JSON, is SPDX
# 2.3 and lists every statically linked dependency.
file(READ "${SBOM}" text)
string(JSON version GET "${text}" spdxVersion)
if(NOT version STREQUAL "SPDX-2.3")
  message(FATAL_ERROR "not SPDX 2.3: ${version}")
endif()
string(JSON count LENGTH "${text}" packages)
set(names "")
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
  string(JSON name GET "${text}" packages ${i} name)
  string(JSON license GET "${text}" packages ${i} licenseConcluded)
  if(license STREQUAL "" OR license STREQUAL "NOASSERTION")
    message(FATAL_ERROR "package ${name} has no concluded licence")
  endif()
  list(APPEND names "${name}")
endforeach()
foreach(required donkey capstone sqlite-amalgamation SDL3 "Dear ImGui (docking)")
  if(NOT required IN_LIST names)
    message(FATAL_ERROR "SBOM is missing ${required}")
  endif()
endforeach()
message(STATUS "SBOM ok: ${count} packages")
