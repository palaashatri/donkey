{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DONKEY_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev-macos",
      "inherits": "base",
      "displayName": "macOS development (Debug, UI)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DONKEY_BUILD_UI": "ON",
        "DONKEY_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "release-macos",
      "inherits": "dev-macos",
      "displayName": "macOS release (Release, UI)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "headless-macos",
      "inherits": "base",
      "displayName": "macOS headless core + CLI (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DONKEY_BUILD_UI": "OFF",
        "DONKEY_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "dev-linux",
      "inherits": "base",
      "displayName": "Linux development (Debug, UI)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DONKEY_BUILD_UI": "ON",
        "DONKEY_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "headless-linux",
      "inherits": "base",
      "displayName": "Linux headless core + CLI (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DONKEY_BUILD_UI": "OFF",
        "DONKEY_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "asan-linux",
      "inherits": "headless-linux",
      "displayName": "Linux headless + ASan/UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "headless-windows",
      "inherits": "base",
      "displayName": "Windows headless core + CLI (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DONKEY_BUILD_UI": "OFF",
        "DONKEY_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev-windows",
      "inherits": "base",
      "displayName": "Windows development (Debug, UI)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DONKEY_BUILD_UI": "ON",
        "DONKEY_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "fuzz-macos",
      "inherits": "base",
      "displayName": "macOS libFuzzer targets (Homebrew LLVM)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_AR": "/usr/bin/ar",
        "CMAKE_RANLIB": "/usr/bin/ranlib",
        "CMAKE_BUILD_TYPE": "Debug",
        "DONKEY_BUILD_TESTS": "OFF",
        "DONKEY_BUILD_FUZZERS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "headless-freebsd",
      "inherits": "base",
      "displayName": "FreeBSD headless core + CLI (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DONKEY_BUILD_UI": "OFF",
        "DONKEY_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "FreeBSD"
      }
    },
    {
      "name": "package-linux",
      "inherits": "base",
      "displayName": "Linux release packages (DEB, RPM, TGZ)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DONKEY_BUILD_UI": "ON",
        "DONKEY_STATIC_RUNTIME": "ON",
        "DONKEY_WARNINGS_AS_ERRORS": "ON",
        "DONKEY_UI_SMOKE_TEST": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "package-macos",
      "inherits": "base",
      "displayName": "macOS arm64 release packages (DMG, ZIP)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DONKEY_BUILD_UI": "ON",
        "DONKEY_STATIC_RUNTIME": "ON",
        "DONKEY_WARNINGS_AS_ERRORS": "ON",
        "DONKEY_UI_SMOKE_TEST": "ON",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "package-windows",
      "inherits": "base",
      "displayName": "Windows release packages (NSIS setup, ZIP)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DONKEY_BUILD_UI": "ON",
        "DONKEY_STATIC_RUNTIME": "ON",
        "DONKEY_WARNINGS_AS_ERRORS": "ON",
        "DONKEY_UI_SMOKE_TEST": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "package-freebsd",
      "inherits": "base",
      "displayName": "FreeBSD release packages (pkg, TGZ)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DONKEY_BUILD_UI": "ON",
        "DONKEY_STATIC_RUNTIME": "ON",
        "DONKEY_WARNINGS_AS_ERRORS": "ON",
        "DONKEY_UI_SMOKE_TEST": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "FreeBSD"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-macos",
      "configurePreset": "dev-macos"
    },
    {
      "name": "release-macos",
